# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local device config (contains API keys/tokens)
hub_config.json

# Git worktrees
.worktrees/

# Claude superpowers working files
.superpowers/

# Planning docs (kept locally, not in repo)
docs/superpowers/

# Claude Code workspace: everything under .claude/ is local/workspace-managed
# (the symlinked .claude/CLAUDE.md, the codrasil-* skills) EXCEPT this repo's own
# hearth-* skills, which are committed so they ship in a plain contributor checkout.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/hearth-*/
